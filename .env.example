# Copie este arquivo para ".env" e ajuste os valores.
# Depois de mudar, basta reiniciar o "next start" (sem precisar rebuildar).

# Nome do site, mostrado no título e no cabeçalho
SITE_NAME="To-Do Semana Universitária"

# Domínio onde o site está publicado, mostrado no rodapé
SITE_DOMAIN="meusite.com.br"

# Nome de quem está apresentando/dono da lista
OWNER_NAME="Seu Nome Aqui"
